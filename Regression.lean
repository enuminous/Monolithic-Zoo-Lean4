import Zoo

open Zoo

def assertNear (label : String) (actual expected : Float) : IO Unit :=
  if Zoo.absF (actual-expected) ≤ 0.000000001 then pure ()
  else throw (IO.userError ("Mismatch: " ++ label ++ " actual=" ++ toString actual ++ " expected=" ++ toString expected))

def assertBool (label : String) (ok : Bool) : IO Unit :=
  if ok then pure () else throw (IO.userError ("Mismatch: " ++ label))

